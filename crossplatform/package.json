{
  "name": "merkzeug",
  "version": "0.1.0",
  "description": "Merkzeug – WYSIWYG-Markdown-Editor (Cross-Platform)",
  "main": "out/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:calhelper": "swiftc -O resources/calendar/MerkzeugCalendar.swift -o resources/calendar/merkzeug-calendar",
    "package:mac": "npm run build:calhelper && electron-vite build && electron-builder --mac dir",
    "package:mac:dmg": "npm run build:calhelper && electron-vite build && electron-builder --mac dmg",
    "package:win": "electron-vite build && ELECTRON_BUILDER_7Z_FILTER=BCJ2 electron-builder --win --x64 --arm64",
    "package:linux": "electron-vite build && electron-builder --linux --x64",
    "notices": "node ../scripts/third-party-notices.mjs",
    "prepackage:mac": "npm run notices",
    "prepackage:mac:dmg": "npm run notices",
    "prepackage:win": "npm run notices",
    "prepackage:linux": "npm run notices"
  },
  "keywords": [],
  "author": "Günther Wieser <guenther.wieser@creative-it.com>",
  "homepage": "https://www.creative-it.com",
  "desktopName": "merkzeug.desktop",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "@merkzeug/core": "0.1.0",
    "@merkzeug/editor": "0.1.0",
    "@merkzeug/export": "0.1.0"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^5.0.0"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Merkzeug"
}
