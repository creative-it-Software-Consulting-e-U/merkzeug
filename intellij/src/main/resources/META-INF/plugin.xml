<idea-plugin>
  <id>com.creativeit.merkzeug</id>
  <name>Merkzeug</name>
  <version>1.0.0</version>
  <vendor>creative-it</vendor>
  <description><![CDATA[WYSIWYG Markdown editor with Mermaid, frontmatter, images and PDF export using shared Merkzeug components. Local preview release.]]></description>
  <idea-version since-build="262.10315" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.jcef</depends>
  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider implementation="com.creativeit.merkzeug.MerkzeugEditorProvider"/>
  </extensions>
  <actions>
    <action id="Merkzeug.ContactSupport" class="com.creativeit.merkzeug.ContactSupportAction" text="Merkzeug: Contact Support…">
      <add-to-group group-id="HelpMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
